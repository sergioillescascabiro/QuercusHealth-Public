# Copy this file to .env and fill in your credentials.
# NEVER commit .env — it is listed in .gitignore.

# Roboflow API key — get yours at https://app.roboflow.com/settings/api
ROBOFLOW_API_KEY=your_roboflow_api_key_here

# Roboflow workspace and project (see your Roboflow dashboard)
ROBOFLOW_WORKSPACE=your_workspace_name_here
ROBOFLOW_PROJECT=quercushealth-dehesa-summer2019
ROBOFLOW_VERSION=1
